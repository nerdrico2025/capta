DATABASE_URL="postgresql://capta:capta@localhost:5432/capta"
REDIS_URL="redis://localhost:6379"
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"

# IA — Enriquecimento automático de editais
OPENAI_API_KEY="sk-proj-your-openai-key-here"   # OpenAI API key (se vazio, usa mock)
ADMIN_API_KEY="change-me-in-production"     # Chave para endpoints /admin

# Coletores
SALIC_API_TOKEN=""                          # Token Bearer para API SALIC (opcional)

# APIs externas
OSC_API_URL="https://mapaosc.ipea.gov.br/api"  # Mapa das OSCs / Ipea
API_URL="http://localhost:3001"                 # URL pública desta API (usada no Swagger)

# E-mail (escolha um dos provedores)
EMAIL_PROVIDER="smtp"                       # "resend" | "smtp"
EMAIL_FROM="Capta <onboarding@resend.dev>"

# Resend (se EMAIL_PROVIDER=resend)
RESEND_API_KEY="re_your-resend-key-here"

# SMTP (se EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Segurança
UNSUBSCRIBE_SECRET="change-me-in-production"  # Segredo para HMAC do token de descadastro

# Frontend URL (para links nos e-mails)
WEB_URL="http://localhost:3000"

# Web Push (VAPID) — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""   # Chave pública — exposta ao cliente via GET /api/push/vapid-key
VAPID_PRIVATE_KEY=""  # Chave privada — manter em segredo
VAPID_SUBJECT="mailto:admin@capta.app"
